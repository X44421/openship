{
  "name": "openship",
  "version": "0.6.5",
  "description": "Open-source, self-hostable deployment platform",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/oblien/openship.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "scripts": {
    "build": "turbo run build --filter=@repo/api --filter=@repo/dashboard",
    "build:all": "turbo run build",
    "start": "turbo run start --filter=@repo/api --filter=@repo/dashboard --concurrency=10",
    "build:desktop": "bun run --cwd apps/desktop make",
    "build:cli": "bun run --cwd apps/cli build",
    "cli": "bun run --cwd apps/cli cli",
    "build:server": "bun run --cwd apps/api build-release",
    "build:email": "bun run --cwd apps/email build",
    "update:geoip": "node scripts/update-geoip.mjs",
    "update:cloudflare-ips": "node scripts/update-cloudflare-ips.mjs",
    "update:world-map": "node scripts/update-world-map.mjs",
    "update:country-hues": "node scripts/update-country-hues.mjs",
    "start:desktop": "node apps/desktop/build/run.mjs",
    "dev:all": "turbo run dev --concurrency=20",
    "dev:api": "turbo run dev --filter=@repo/api...",
    "dev": "turbo run dev --filter=@repo/api --filter=@repo/dashboard --concurrency=10",
    "dev:saas": "turbo run dev:saas --filter=@repo/api --filter=@repo/dashboard --concurrency=10",
    "dev:local-saas": "turbo run dev:local-saas --filter=@repo/api --filter=@repo/dashboard --concurrency=10",
    "dev:dashboard": "turbo run dev --filter=@repo/dashboard",
    "dev:desktop": "turbo run dev --filter=@repo/desktop",
    "dev:web": "turbo run dev --filter=@repo/web",
    "dev:email": "turbo run dev --filter=@repo/email",
    "dev:turbo": "turbo run dev",
    "clean": "ps -A -o pid,command 2>/dev/null | grep -E 'src/index\\.ts|next/dist/bin/next' | grep -v grep | awk '{print $1}' | xargs -I {} kill -9 {} 2>/dev/null; for p in 4000 4100 3001 3002; do pid=$(lsof -ti tcp:$p 2>/dev/null); [ -n \"$pid\" ] && kill -9 $pid 2>/dev/null; done; echo 'cleaned'",
    "lint": "turbo run lint --filter=!@repo/email",
    "check:boundaries": "node scripts/check-dependency-boundaries.mjs",
    "lint:boundaries": "eslint . --no-inline-config",
    "test": "turbo run test --filter=!@repo/email --concurrency=1",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "turbo run db:generate --filter=@repo/db",
    "db:push": "turbo run db:push --filter=@repo/db",
    "db:migrate": "turbo run db:migrate --filter=@repo/db",
    "dev:clean": "turbo run clean && rm -rf node_modules",
    "clean:modules": "find apps packages -name node_modules -type d -prune -exec rm -rf {} + && rm -rf node_modules",
    "release": "bun scripts/release.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "fast-uri": "^3.1.6",
    "ip-address": "^10.3.1",
    "kysely": "^0.28.17",
    "mysql2": "^3.23.1",
    "lodash": "^4.18.0",
    "path-to-regexp": "^8.4.0",
    "postcss": "^8.5.23",
    "protobufjs": "^7.5.6",
    "qs": "^6.16.0",
    "sharp": "^0.35.0",
    "tmp": "^0.2.6",
    "underscore": "^1.13.8",
    "uuid": "^11.1.1",
    "valibot": "^1.4.2",
    "effect": "^3.20.0",
    "drizzle-orm": "^0.45.2",
    "deepmerge-ts": "^8.0.0",
    "defu": "^6.1.5",
    "browserslist": "^4.28.7",
    "body-parser": "^2.3.0",
    "@xmldom/xmldom": "^0.8.15",
    "nodemailer": "^9.0.1",
    "@tootallnate/once": "^2.0.1",
    "@grpc/grpc-js": "^1.14.4",
    "@hono/node-server": "^1.19.15",
    "vite": "^7.3.5",
    "better-auth": "1.6.30"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.8.1",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@octokit/auth-oauth-device": "^8.0.3",
    "api": "^6.1.3",
    "sonner": "^2.0.7"
  }
}
