{
  "name": "@stillflow/contracts",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "//authority": [
    "Target topology contract (FE0-C2, docs/issues/issue-013-package-topology-contract.md §1):",
    "this package contains ONLY generated DTOs, enums, and version constants.",
    "Hand-written business types are forbidden here (FE0-C1 contract §2.2)."
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "verify": "node scripts/verify.mjs",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "lint": "tsc --noEmit && node scripts/verify.mjs",
    "test": "node scripts/verify.mjs",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
